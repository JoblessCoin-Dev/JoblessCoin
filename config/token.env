# JoblessCoin token parameters — the single source of truth for every script.
# Changing a value here changes what gets created on-chain. Review carefully.

TOKEN_NAME="JoblessCoin"
TOKEN_SYMBOL="JOB"
TOKEN_DECIMALS=9
# Total supply in whole tokens (base units = TOKEN_SUPPLY * 10^TOKEN_DECIMALS).
TOKEN_SUPPLY=1000000000
TOKEN_URI="https://deluxe-mochi-c9b389.netlify.app/joblesscoin.json"

# How the total supply is split, as name:percent pairs (must add up to 100).
ALLOCATIONS="liquidity:90 community:5 development:5"

# Vesting of the development allocation (Streamflow, irrevocable), in days from locking:
# nothing unlocks before the cliff, then it unlocks daily until the end.
DEV_VESTING_CLIFF_DAYS=90
DEV_VESTING_TOTAL_DAYS=365

# The only Token-2022 extensions allowed on the mint. Anything else (permanent
# delegate, transfer fee, transfer hook, ...) fails verification.
ALLOWED_EXTENSIONS="metadataPointer tokenMetadata"
